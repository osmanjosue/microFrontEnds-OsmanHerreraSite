# ==========================================
# 1. ESENCIALES Y SEGURIDAD (Global)
# ==========================================
# Dependencias
**/node_modules/
# Documentación local
docs/*
!docs/handoff/
!docs/handoff/**
!docs/*.md

# Variables de entorno y secretos (¡NUNCA SUBIR!)
.env
.env.local
.env.*.local
**/.env
**/.env.local
*.pem
*.key
*.pub

# Archivos de sistema y logs
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# 2. COMPILACIÓN Y SALIDA (Universal para Monorepo)
# ==========================================
# Ignora cualquier carpeta dist, out o build en cualquier subdirectorio
**/dist/
**/dist-browser/
**/out/
**/build/

# Específicos de Angular, Vite y Astro (Cachés de desarrollo)
**/.angular/
**/.vite/
**/.astro/
.cache/
.sourcemaps/
.metadata/

# ==========================================
# 3. HERRAMIENTAS DE DESARROLLO (Azure/VS Code)
# ==========================================
.vscode/*
!.vscode/extensions.json
.idea/
*.code-workspace

# Ignorar assets copiados en builds (por si acaso fallara el filtro de dist)
**/src/assets/temp/

# Vector Work: fuentes editables, artes y títulos reales NUNCA en git (repo público)
osmanHerreraSiteVector/source/*
osmanHerreraSiteVector/public/works/*
osmanHerreraSiteVector/public/data/titles.json
osmanHerreraSiteAstro/public/vectorwork/works/*
osmanHerreraSiteAstro/public/vectorwork/data/titles.json
osmanHerreraSiteAstro/scripts/vector/.screenshots/
osmanHerreraSiteAstro/scripts/vector/fixtures/out/

# Estado y logs del orquestador Gemini <-> Claude
.handoff-loop/

