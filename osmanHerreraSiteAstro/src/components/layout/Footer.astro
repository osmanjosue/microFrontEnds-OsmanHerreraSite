---
// ===========================================================================
// COMPONENTE LAYOUT: FOOTER (PIE DE PÁGINA BILINGÜE APEX DOSSIER)
// ===========================================================================
import { siteConfig, type Lang, t, localizedPath } from '@config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const privacyPath = localizedPath(siteConfig.footer.privacyLink.targetRoute, lang);
---

<footer class="w-full bg-surface-container-lowest py-space-xl border-t border-outline-variant/30">
  <div class="max-w-7xl mx-auto px-margin flex flex-col md:flex-row items-center justify-between gap-space-md text-center md:text-left">
    <div class="flex flex-wrap items-center justify-center md:justify-start gap-space-xs font-label-micro text-label-micro text-on-surface-variant uppercase tracking-wider">
      <span class="text-primary-fixed">{t(siteConfig.footer.copyright, lang)}</span>
      <span class="text-outline">//</span>
      <span>{t(siteConfig.footer.credit, lang)}</span>
      <span class="text-outline">//</span>
      <a class="text-on-surface-variant hover:text-primary transition-colors underline-offset-4 hover:underline" href={privacyPath}>
        {t(siteConfig.footer.privacyLink.label, lang)}
      </a>
    </div>
  </div>
</footer>
