---
// ===========================================================================
// SECCIÓN: CONTACT / CANALES DE CONTACTO (05)
// ===========================================================================
// Presenta las vías de comunicación directas y el contenedor para la isla del
// formulario de contacto de la Fase 5.

import { siteConfig, type Lang, t } from '@config';
import SectionHeader from '../ui/SectionHeader.astro';
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { contact, socialIcons, contactForm } = siteConfig;
---

<section id="contact" class="py-space-xl">
  <div class="max-w-7xl mx-auto px-margin">
    <SectionHeader
      kicker={t(contact.kicker, lang)}
      title={t(contact.title, lang)}
      subtitle={t(contact.subtitle, lang)}
      index={5}
      class="mb-space-lg border-b border-outline-variant pb-space-md"
    />

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] gap-space-xl items-start">
      <!-- COLUMNA IZQUIERDA: INFORMACIÓN Y REDES -->
      <div class="space-y-space-lg">
        <p class="font-body-md text-on-surface-variant leading-relaxed max-w-md">
          {t(contact.intro, lang)}
        </p>

        <!-- Redes sociales directas -->
        <div class="space-y-space-sm">
          <h4 class="font-label-caps text-label-caps text-primary-container uppercase tracking-wider">
            {t(contact.channelsTitle, lang)}
          </h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-sm">
            {socialIcons.map((social) => (
              <a
                href={social.address}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-space-sm p-space-md bg-surface-container border border-outline-variant hover:border-primary-container/60 hover:bg-surface-container-high transition-all chamfer group"
              >
                <span
                  class="icon-mask w-5 h-5 group-hover:brightness-125 transition-all"
                  style={`--icon-url: url(${social.icon})`}
                  aria-hidden="true"
                ></span>
                <span class="font-label-caps text-label-caps uppercase tracking-wider text-on-surface group-hover:text-primary-container transition-colors">
                  {social.title}
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- COLUMNA DERECHA: CONTENEDOR DEL FORMULARIO (ISLA FASE 5) -->
      <div id="contact-form-island-container">
        <Card variant="interactive" cornerMarks={true} class="p-space-lg lg:p-space-xl">
          <div class="space-y-space-md">
            <div class="flex items-center justify-between pb-space-sm border-b border-outline-variant/30">
              <span class="font-label-caps text-label-caps text-primary-container uppercase tracking-wider">
                {t(contact.formTitle, lang)}
              </span>
              <span class="font-mono text-label-micro text-on-surface-variant">
                // FORM_CHANNEL
              </span>
            </div>

            <!-- Placeholder técnico de Fase 4 que será enriquecido por la isla de React en la Fase 5 -->
            <div class="space-y-space-sm py-space-sm">
              <p class="font-body-sm text-on-surface-variant">
                {t(contactForm.note, lang)}
              </p>
              <div class="pt-space-sm">
                <Button
                  variant="primary"
                  href={`mailto:${contact.email}`}
                  icon="mail"
                  class="w-full justify-center"
                >
                  {t(contactForm.submit, lang)}
                </Button>
              </div>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </div>
</section>
