---
// ===========================================================================
// SECCIÓN: FORMATION / EDUCACIÓN Y CERTIFICACIONES (03)
// ===========================================================================
// Presenta la educación universitaria formal y las certificaciones técnicas obtenidas.

import { siteConfig, type Lang, t } from '@config';
import SectionHeader from '../ui/SectionHeader.astro';
import Card from '../ui/Card.astro';
import Chip from '../ui/Chip.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { formation } = siteConfig;
---

<section id="formation" class="py-space-xl">
  <div class="max-w-7xl mx-auto px-margin">
    <SectionHeader
      kicker={t(formation.kicker, lang)}
      title={t(formation.title, lang)}
      index={3}
      class="mb-space-lg border-b border-outline-variant pb-space-md"
    />

    <!-- EDUCACIÓN FORMAL -->
    <div class="mb-space-xl">
      <h3 class="font-label-caps text-label-caps text-primary-container uppercase tracking-wider mb-space-md flex items-center gap-space-xs">
        <span class="material-symbols-outlined text-base">school</span>
        <span>{t(formation.educationTitle, lang)}</span>
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-space-lg">
        {formation.education.map((edu) => (
          <Card variant="interactive" cornerMarks={true} class="flex flex-col justify-between gap-space-md">
            <div class="space-y-space-sm">
              <Chip variant="tactical">{t(edu.platform, lang)}</Chip>
              <h4 class="font-headline-md text-headline-md text-primary leading-snug">
                {t(edu.title, lang)}
              </h4>
            </div>
            <p class="font-body-sm text-on-surface-variant flex items-center gap-space-xs pt-space-sm border-t border-outline-variant/30">
              <span class="material-symbols-outlined text-sm text-secondary">verified</span>
              <span>{t(edu.detail, lang)}</span>
            </p>
          </Card>
        ))}
      </div>
    </div>

    <!-- CERTIFICACIONES TÉCNICAS -->
    <div>
      <h3 class="font-label-caps text-label-caps text-primary-container uppercase tracking-wider mb-space-md flex items-center gap-space-xs">
        <span class="material-symbols-outlined text-base">workspace_premium</span>
        <span>{t(formation.certificatesTitle, lang)}</span>
      </h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-md">
        {formation.certificates.map((cert) => (
          <Card variant="interactive" class="flex flex-col justify-between gap-space-md p-space-md">
            <div class="space-y-space-sm">
              <div class="flex items-center justify-between gap-space-xs">
                <Chip variant="common">{cert.platform}</Chip>
                {(cert.month || cert.date) && (
                  <span class="font-mono text-label-micro text-on-surface-variant">
                    {cert.month ? t(cert.month, lang) : ''} {cert.date ?? ''}
                  </span>
                )}
              </div>
              <h4 class="font-title-md text-title-md text-primary font-semibold leading-snug">
                {cert.title}
              </h4>
            </div>

            {cert.link && (
              <div class="pt-space-sm border-t border-outline-variant/30">
                <a
                  href={cert.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 font-label-caps text-label-caps text-primary-container hover:text-primary-fixed hover:underline transition-colors"
                >
                  <span>{t(formation.certificateLinkLabel, lang)}</span>
                </a>
              </div>
            )}
          </Card>
        ))}
      </div>
    </div>
  </div>
</section>
