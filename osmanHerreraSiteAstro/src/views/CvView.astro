---
// ===========================================================================
// VISTA: CV / HOJA DE VIDA (BILINGÜE)
// ===========================================================================
// Renderiza el perfil público completo estructurado en 10 secciones,
// optimizado para visualización web y exportación a impresión / PDF (A4/Letter).

import { siteConfig, type Lang, t } from '@config';
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/ui/Card.astro';
import Chip from '../components/ui/Chip.astro';
import Experience from '../components/sections/Experience.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { cv, formation, projects } = siteConfig;

const nightAudit = projects.items.find(
  (p) => p.id === 'night-audit-revenue-pipeline',
);
---

<BaseLayout lang={lang} route="cv">
  <div class="max-w-5xl mx-auto px-margin py-space-lg print-page space-y-space-xl">
    <!-- 1. ENCABEZADO -->
    <header class="border-b border-outline-variant/60 pb-space-lg cv-header">
      <div class="flex flex-wrap items-center justify-between gap-space-sm mb-space-md">
        <span class="font-mono text-label-micro text-primary-container tracking-wider">
          osmanherrera.dev
        </span>
        <button
          type="button"
          onclick="window.print()"
          class="no-print inline-flex items-center gap-space-xs px-space-md py-1.5 bg-surface-container hover:bg-surface-container-high text-primary border border-outline-variant hover:border-primary-container font-mono text-label-micro uppercase tracking-wider transition-colors cursor-pointer"
        >
          <span class="material-symbols-outlined text-sm">print</span>
          <span>{t(cv.ui.printPdfBtn, lang)}</span>
        </button>
      </div>

      <h1 class="font-headline-xl text-headline-xl text-primary font-bold tracking-tight">
        Osman Herrera
      </h1>
      <p class="font-headline-sm text-headline-sm text-primary-container font-medium mt-1">
        {t(cv.headline, lang)}
      </p>
      <p class="font-body-sm text-on-surface-variant mt-1 flex items-center gap-1">
        <span class="material-symbols-outlined text-sm text-outline">location_on</span>
        <span>{t(cv.location, lang)}</span>
      </p>

      <!-- Enlaces de contacto -->
      <nav class="flex flex-wrap gap-space-xs pt-space-md" aria-label="Contacto CV">
        <a
          href={`mailto:${siteConfig.contact.email}`}
          class="inline-flex items-center gap-1 px-3 py-1 bg-surface-container border border-outline-variant hover:border-primary-container text-on-surface font-mono text-label-micro transition-colors"
        >
          <span class="text-primary-container">✉</span>
          <span>{siteConfig.contact.email}</span>
        </a>
        <a
          href="tel:+50489709021"
          class="inline-flex items-center gap-1 px-3 py-1 bg-surface-container border border-outline-variant hover:border-primary-container text-on-surface font-mono text-label-micro transition-colors"
        >
          <span class="text-primary-container">☎</span>
          <span>(+504) 8970-9021</span>
        </a>
        <a
          href="https://linkedin.com/in/osmanherrera"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 px-3 py-1 bg-surface-container border border-outline-variant hover:border-primary-container text-on-surface font-mono text-label-micro transition-colors"
        >
          <span class="text-primary-container font-bold">in</span>
          <span>LinkedIn</span>
        </a>
        <a
          href="https://github.com/osmanjosue"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 px-3 py-1 bg-surface-container border border-outline-variant hover:border-primary-container text-on-surface font-mono text-label-micro transition-colors"
        >
          <span class="text-primary-container font-bold">&lt;/&gt;</span>
          <span>GitHub</span>
        </a>
        <a
          href="https://osmanherrera.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 px-3 py-1 bg-surface-container border border-outline-variant hover:border-primary-container text-on-surface font-mono text-label-micro transition-colors"
        >
          <span class="text-primary-container font-bold">◎</span>
          <span>osmanherrera.dev</span>
        </a>
      </nav>
    </header>

    <!-- 2. PERFIL -->
    <section class="space-y-space-xs">
      <h2 class="font-mono text-label-micro text-primary-container uppercase tracking-widest">
        // {t(cv.ui.profileSection, lang)}
      </h2>
      <p class="font-body-md text-on-surface leading-relaxed max-w-4xl text-base lg:text-lg">
        {t(cv.profileSummary, lang)}
      </p>
    </section>

    <!-- 3. QUÉ HAGO -->
    <section class="space-y-space-sm">
      <h2 class="font-mono text-label-micro text-primary-container uppercase tracking-widest">
        // {t(cv.ui.whatIDoSection, lang)}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-sm">
        {cv.whatIDo.map((item) => (
          <Card variant="interactive" class="cv-card p-space-md border-t-2 border-t-primary-container">
            <h3 class="font-headline-sm text-headline-sm text-primary mb-1">
              {t(item.title, lang)}
            </h3>
            <p class="font-body-sm text-on-surface-variant leading-relaxed">
              {t(item.description, lang)}
            </p>
          </Card>
        ))}
      </div>
    </section>

    <!-- 4. EXPERIENCIA -->
    <section class="space-y-space-sm">
      <h2 class="font-mono text-label-micro text-primary-container uppercase tracking-widest">
        // {t(cv.ui.experienceSection, lang)}
      </h2>
      <Experience lang={lang} showHeader={false} sectionClass="py-0" />
    </section>

    <!-- 5. PROYECTOS DESTACADOS -->
    <section class="space-y-space-md">
      <h2 class="font-mono text-label-micro text-primary-container uppercase tracking-widest">
        // {t(cv.ui.featuredProjectsSection, lang)}
      </h2>

      <!-- Night Audit Case Study -->
      {nightAudit && nightAudit.caseStudy && (
        <Card variant="interactive" cornerMarks={true} class="cv-card p-space-lg lg:p-space-xl border-l-4 border-l-primary-container break-inside-avoid">
          <div class="flex flex-wrap items-center justify-between gap-space-xs mb-space-sm">
            <h3 class="font-headline-md text-headline-md text-primary font-bold">
              {t(nightAudit.title, lang)}
            </h3>
            <Chip variant="tactical">{t(nightAudit.badge!, lang)}</Chip>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-space-md my-space-md">
            <div class="space-y-1">
              <h4 class="font-mono text-label-micro text-outline uppercase tracking-wider">
                {t(cv.ui.problemLabel, lang)}
              </h4>
              <p class="font-body-sm text-on-surface-variant leading-relaxed">
                {t(nightAudit.caseStudy.problem, lang)}
              </p>
            </div>
            <div class="space-y-1">
              <h4 class="font-mono text-label-micro text-outline uppercase tracking-wider">
                {t(cv.ui.solutionLabel, lang)}
              </h4>
              <p class="font-body-sm text-on-surface-variant leading-relaxed">
                {t(nightAudit.caseStudy.solution, lang)}
              </p>
            </div>
            <div class="space-y-1">
              <h4 class="font-mono text-label-micro text-outline uppercase tracking-wider">
                {t(cv.ui.resultLabel, lang)}
              </h4>
              <p class="font-body-sm text-on-surface-variant leading-relaxed">
                {t(nightAudit.caseStudy.result, lang)}
              </p>
            </div>
          </div>

          <div class="flex flex-wrap gap-1 mt-space-sm">
            {nightAudit.technologies.map((tech) => (
              <Chip variant="common">{tech}</Chip>
            ))}
          </div>

          <div class="mt-space-md pt-space-xs border-t border-outline-variant/30">
            <a
              href={nightAudit.links[0]?.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 font-mono text-label-micro text-primary-container hover:text-primary font-semibold tracking-wider uppercase transition-colors"
            >
              <span>{t(cv.ui.viewCode, lang)} →</span>
            </a>
          </div>
        </Card>
      )}

      <!-- 3 Brief Projects -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-space-sm">
        {cv.briefProjects.map((p) => (
          <Card variant="interactive" class="cv-card p-space-md flex flex-col justify-between gap-space-sm break-inside-avoid">
            <div class="space-y-space-xs">
              <h3 class="font-headline-sm text-headline-sm text-primary">
                {p.title}
              </h3>
              <p class="font-body-sm text-on-surface-variant leading-relaxed">
                {t(p.description, lang)}
              </p>
            </div>
            {p.chips.length > 0 && (
              <div class="flex flex-wrap gap-1 pt-space-xs">
                {p.chips.map((chip) => (
                  <Chip variant="common">{chip}</Chip>
                ))}
              </div>
            )}
          </Card>
        ))}
      </div>
    </section>

    <!-- 6. HABILIDADES -->
    <section class="space-y-space-sm">
      <h2 class="font-mono text-label-micro text-primary-container uppercase tracking-widest">
        // {t(cv.ui.skillsSection, lang)}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-space-sm">
        {cv.skillGroups.map((group) => (
          <Card variant="interactive" class="cv-card p-space-md break-inside-avoid">
            <h3 class="font-headline-sm text-headline-sm text-primary mb-space-xs pb-1 border-b border-outline-variant/30">
              {t(group.title, lang)}
            </h3>
            <div class="flex flex-wrap gap-1">
              {group.skills.map((skill) => (
                <Chip variant={skill.level === 'core' ? 'tactical' : 'common'}>
                  {skill.name}
                </Chip>
              ))}
            </div>
          </Card>
        ))}
      </div>
    </section>

    <!-- 7. FORTALEZAS -->
    <section class="space-y-space-xs">
      <h2 class="font-mono text-label-micro text-primary-container uppercase tracking-widest">
        // {t(cv.ui.strengthsSection, lang)}
      </h2>
      <div class="flex flex-wrap gap-1.5">
        {t(cv.strengths, lang).map((strength) => (
          <Chip variant="common" class="text-xs py-1 px-3">
            {strength}
          </Chip>
        ))}
      </div>
    </section>

    <!-- 8. EDUCACIÓN Y 9. IDIOMAS -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-space-lg">
      <!-- 8. Educación y certificaciones -->
      <section class="space-y-space-xs break-inside-avoid">
        <h2 class="font-mono text-label-micro text-primary-container uppercase tracking-widest">
          // {t(cv.ui.educationSection, lang)}
        </h2>
        <Card variant="interactive" class="cv-card p-space-md space-y-space-sm">
          {formation.education.map((edu) => (
            <div>
              <h3 class="font-title-md text-title-md text-primary font-bold">
                {t(edu.title, lang)}
              </h3>
              <p class="font-body-sm text-on-surface-variant">
                {t(edu.detail, lang)}
              </p>
            </div>
          ))}

          <div class="pt-space-xs border-t border-outline-variant/30 space-y-2">
            {formation.certificates.map((cert) => (
              <div class="text-sm">
                <span class="font-medium text-on-surface">{cert.title}</span>
                <span class="text-on-surface-variant font-mono text-xs"> — {cert.platform}</span>
              </div>
            ))}
          </div>
        </Card>
      </section>

      <!-- 9. Idiomas -->
      <section class="space-y-space-xs break-inside-avoid">
        <h2 class="font-mono text-label-micro text-primary-container uppercase tracking-widest">
          // {t(cv.ui.languagesSection, lang)}
        </h2>
        <Card variant="interactive" class="cv-card p-space-md space-y-space-sm">
          {cv.languages.map((langItem) => (
            <div class="flex items-center justify-between py-1 border-b border-outline-variant/30 last:border-b-0">
              <span class="font-medium text-primary">
                {t(langItem.language, lang)}
              </span>
              <Chip variant="tactical">
                {t(langItem.level, lang)}
              </Chip>
            </div>
          ))}
        </Card>
      </section>
    </div>

    <!-- 10. SOBRE MÍ -->
    <section class="space-y-space-xs break-inside-avoid">
      <h2 class="font-mono text-label-micro text-primary-container uppercase tracking-widest">
        // {t(cv.ui.aboutMeSection, lang)}
      </h2>
      <p class="font-body-md text-on-surface-variant leading-relaxed">
        {t(cv.aboutMe, lang)}
      </p>
      <Card variant="interactive" class="cv-card p-space-md flex items-start gap-space-sm mt-space-sm border-l-2 border-l-secondary">
        <span class="text-2xl select-none" aria-hidden="true">🥋</span>
        <p class="font-body-sm text-on-surface leading-relaxed">
          {t(cv.taekwondo, lang)}
        </p>
      </Card>
    </section>

    <!-- FOOTER CV -->
    <footer class="pt-space-md border-t border-outline-variant/40 text-center font-mono text-label-micro text-on-surface-variant">
      <span>{t(cv.ui.updatedLabel, lang)}: {cv.updated} · © 2026 Osman Herrera</span>
    </footer>
  </div>
</BaseLayout>

<style>
  @media print {
    :global(header),
    :global(footer),
    :global(#mobile-menu),
    .no-print {
      display: none !important;
    }

    :global(main) {
      padding-top: 0 !important;
      background: #ffffff !important;
      color: #18181b !important;
    }

    :global(body) {
      background: #ffffff !important;
      color: #18181b !important;
      font-size: 10pt !important;
    }

    .print-page {
      max-width: 100% !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    .cv-card {
      background: #ffffff !important;
      border: 1px solid #e4e4e7 !important;
      box-shadow: none !important;
      color: #18181b !important;
      break-inside: avoid !important;
      page-break-inside: avoid !important;
    }

    :global(.chamfer) {
      clip-path: none !important;
    }

    a {
      color: #18181b !important;
      text-decoration: none !important;
    }
  }
</style>
