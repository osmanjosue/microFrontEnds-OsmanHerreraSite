---
// ===========================================================================
// VISTA: POLÍTICA DE PRIVACIDAD / PRIVACY POLICY (BILINGÜE)
// ===========================================================================
import { siteConfig, type Lang, t, localizedPath } from '@config';
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const homePath = localizedPath('home', lang);
const titleText = t(siteConfig.footer.privacyLink.label, lang);
---

<BaseLayout lang={lang} route="privacy" title={`${titleText} — ${siteConfig.brand.highlight}${siteConfig.brand.rest}`}>
  <div class="max-w-4xl mx-auto px-margin py-space-xl space-y-space-lg">
    <div class="flex items-center justify-between">
      <Button variant="ghost" href={homePath} icon="arrow_back">
        {t(siteConfig.privacyPolicy.backLabel, lang)}
      </Button>
    </div>

    <Card chamfer={true} cornerMarks={true} class="space-y-space-md">
      <SectionHeader
        kicker={t(siteConfig.privacyPolicy.kicker, lang)}
        title={titleText}
        subtitle={t(siteConfig.privacyPolicy.lastUpdated, lang)}
      />

      <p class="font-body-md text-on-surface-variant">
        {siteConfig.privacyPolicy.owner}
      </p>

      <div class="pt-space-md border-t border-outline-variant flex justify-start">
        <Button variant="primary" href={homePath} icon="arrow_back">
          {t(siteConfig.privacyPolicy.homeLabel, lang)}
        </Button>
      </div>
    </Card>
  </div>
</BaseLayout>
