---
// ===========================================================================
// PÁGINA INICIAL MÍNIMA (FASE 1)
// ===========================================================================
import { siteConfig } from '@shared/content';
import '../styles/global.css';

const { brand } = siteConfig;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{brand.highlight}{brand.rest}</title>
  </head>
  <body class="bg-surface text-on-surface min-h-screen p-8 flex flex-col items-center justify-center">
    <main class="border border-outline-variant bg-surface-container p-6 chamfer max-w-md w-full">
      <p class="font-label-caps text-label-caps text-surface-tint uppercase mb-2">Apex Dossier // Fase 1</p>
      <h1 class="text-headline-lg font-bold text-primary-container">
        <span class="text-primary-container">{brand.highlight}</span>
        <span class="text-on-surface">{brand.rest}</span>
      </h1>
      <p class="mt-4 text-body-md text-on-surface-variant">
        Astro + Tailwind CSS 3 (PostCSS) + preset compartido configurados exitosamente.
      </p>
    </main>
  </body>
</html>
