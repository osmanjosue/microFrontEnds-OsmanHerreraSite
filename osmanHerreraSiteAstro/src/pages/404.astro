---
// ===========================================================================
// PÁGINA 404 BILINGÜE — ERROR 404 // RECURSO NO LOCALIZADO
// ===========================================================================
// Presenta la información de error 404 en inglés (idioma por defecto) y español,
// permitiendo al usuario volver al inicio en su idioma preferido.
// Todos los textos provienen de siteConfig.notFound en shared/config/site.config.ts.
// ===========================================================================

import { siteConfig, localizedPath } from '@config';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Chip from '../components/ui/Chip.astro';

const { notFound } = siteConfig;
---

<BaseLayout
  lang="en"
  route="home"
  title={notFound.metaTitle.en}
  description={notFound.metaDescription.en}
  noindex={true}
>
  <section class="min-h-[70vh] flex items-center justify-center px-margin py-space-xl">
    <div class="max-w-3xl w-full mx-auto flex flex-col items-center text-center space-y-space-lg">
      <!-- KICKER TÁCTICO -->
      <div class="flex items-center gap-space-xs flex-wrap justify-center">
        <Chip variant="tactical">
          <span class="w-1.5 h-1.5 rounded-full bg-primary-container animate-pulse"></span>
          <span>{notFound.kicker.en}</span>
        </Chip>
        <span class="text-outline-variant text-label-caps">//</span>
        <Chip variant="common">
          <span>{notFound.kicker.es}</span>
        </Chip>
      </div>

      <!-- CÓDIGO DE ERROR GIGANTE CON APEX DOSSIER AESTHETICS -->
      <div class="relative select-none my-space-xs">
        <span class="font-stat-display text-7xl sm:text-9xl font-bold tracking-tighter text-primary-container drop-shadow-[0_0_35px_rgba(0,240,255,0.4)]">
          {notFound.code}
        </span>
      </div>

      <!-- TARJETAS BILINGÜES EN REJILLA RESPONSIVA -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-space-md w-full text-left">
        <!-- SECCIÓN EN INGLÉS (IDIOMA POR DEFECTO) -->
        <Card chamfer class="p-space-md flex flex-col justify-between space-y-space-md border-surface-container-high/60">
          <div class="space-y-space-xs">
            <div class="flex items-center justify-between">
              <span class="font-label-caps text-label-caps text-primary-container font-bold tracking-wider">
                {notFound.langLabel.en}
              </span>
              <span class="w-2 h-2 rounded-full bg-primary-container"></span>
            </div>
            <h1 class="font-headline-md text-headline-md text-primary font-bold">
              {notFound.title.en}
            </h1>
            <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
              {notFound.description.en}
            </p>
          </div>
          <div>
            <Button href={localizedPath('home', 'en')} variant="primary" icon="arrow_back">
              {notFound.homeLink.en}
            </Button>
          </div>
        </Card>

        <!-- SECCIÓN EN ESPAÑOL (ACCESIBLE CON lang="es") -->
        <Card chamfer lang="es" class="p-space-md flex flex-col justify-between space-y-space-md border-surface-container-high/60">
          <div class="space-y-space-xs">
            <div class="flex items-center justify-between">
              <span class="font-label-caps text-label-caps text-secondary font-bold tracking-wider">
                {notFound.langLabel.es}
              </span>
              <span class="w-2 h-2 rounded-full bg-secondary"></span>
            </div>
            <h2 class="font-headline-md text-headline-md text-primary font-bold">
              {notFound.title.es}
            </h2>
            <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
              {notFound.description.es}
            </p>
          </div>
          <div>
            <Button href={localizedPath('home', 'es')} variant="ghost" icon="arrow_forward">
              {notFound.homeLink.es}
            </Button>
          </div>
        </Card>
      </div>
    </div>
  </section>
</BaseLayout>
